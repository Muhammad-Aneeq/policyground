# ---------------------------------------------------------------- mode --
# local: BM25 + local vector store + RRF fusion. Runs with zero cloud dependencies.
# azure: AzureSearchRetriever against Azure AI Search. Deployment-ready, never deployed here.
APP_MODE=local

# ------------------------------------------------------------- models --
# With no key, PolicyGround falls back to HashEmbedder + an extractive offline
# compose stub and says so at startup — the whole app still runs.
# OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.6-luna
# Compose is constrained extraction, not deliberation, and runs on every answered
# question — so `low`. NOTE: the GPT-5.6 family rejects `temperature` outright
# (400, only the default 1 is accepted); reasoning_effort is the lever instead.
OPENAI_REASONING_EFFORT=low

# ------------------------------------------------------- azure (mode=azure) --
# AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
# AZURE_SEARCH_API_KEY=
# AZURE_SEARCH_INDEX=policyground-chunks

# ---------------------------------------------------------------- data --
DATABASE_URL=sqlite:///data/policyground.db

# ------------------------------------------------------------ retrieval --
RETRIEVAL_TOP_K=6
# Below this, the graph refuses. Calibrated by sweeping the question bank's CALIBRATION split
# only and maximising Youden's J; CI gates on the untouched gate split (PLAN.md D-019).
# The full sweep is published in docs/evals_methodology.md.
SUFFICIENCY_THRESHOLD=0.80
