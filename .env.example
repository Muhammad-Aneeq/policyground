# ---------------------------------------------------------------- mode --
# local: BM25 + local vector store + RRF fusion. Runs with zero cloud dependencies.
# azure: AzureSearchRetriever against Azure AI Search. Deployment-ready, never deployed here.
APP_MODE=local

# ------------------------------------------------------------- models --
# Absent in this build (BLOCKERS.md B1). With no key, PolicyGround falls back to
# HashEmbedder + an extractive offline compose stub and says so at startup.
# OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-mini

# ------------------------------------------------------- azure (mode=azure) --
# AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_SEARCH_ENDPOINT=https://<name>.search.windows.net
# AZURE_SEARCH_API_KEY=
# AZURE_SEARCH_INDEX=policyground-chunks

# ---------------------------------------------------------------- data --
DATABASE_URL=sqlite:///data/policyground.db

# ------------------------------------------------------------ retrieval --
RETRIEVAL_TOP_K=6
# Below this, the graph refuses. Calibrated on the question bank's calibration split
# only (PLAN.md D-019); see docs/evals_methodology.md for the calibration table.
SUFFICIENCY_THRESHOLD=0.45
