# Generated retrieval indexes + dev database (rebuildable: `pg ingest --rebuild`)
data/
*.db
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
frontend/dist/

# Secrets — never commit
.env
.env.local
.azure/

# Demo recordings — kept local, never pushed.
# The stills in media/*.png ARE committed: the README is screenshot-first and would
# render with broken images without them. Only the video files are excluded.
media/*.mp4
media/*.webm
media/*.mov
media/*.gif

# OS
.DS_Store
Thumbs.db
